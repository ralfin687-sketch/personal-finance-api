Project personal_finance_api {
  database_type: "PostgreSQL"
  Note: "ERD awal untuk Personal Finance API"
}

Table users {
  id bigint [pk, increment]
  full_name varchar(120) [not null]
  email varchar(254) [not null, unique]
  created_at timestamptz [not null]
}

Table categories {
  id bigint [pk, increment]
  name varchar(80) [not null]
  type varchar(10) [not null, note: "income | expense"]
  created_at timestamptz [not null]
  indexes {
    (name, type) [unique]
  }
}

Table accounts {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  name varchar(80) [not null]
  account_type varchar(10) [not null]
  initial_balance numeric(14,2) [not null]
  created_at timestamptz [not null]
}

Table transactions {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  account_id bigint [not null, ref: > accounts.id]
  category_id bigint [not null, ref: > categories.id]
  type varchar(10) [not null]
  amount numeric(14,2) [not null]
  description varchar(500)
  transaction_date date [not null]
  created_at timestamptz [not null]
}

Table budgets {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  category_id bigint [not null, ref: > categories.id]
  amount_limit numeric(14,2) [not null]
  period_start date [not null]
  period_end date [not null]
  created_at timestamptz [not null]
}

Table savings_goals {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  name varchar(120) [not null]
  target_amount numeric(14,2) [not null]
  target_date date
  created_at timestamptz [not null]
}
